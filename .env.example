# Copy to .env and replace blanks. Use long random values; never commit .env.
NEO4J_PASSWORD=
BISHE_MYSQL_ROOT_PASSWORD=
BISHE_MYSQL_PASSWORD=
APP_JWT_SECRET=
# Set both to create an initial admin, or leave both empty.
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=
# Optional. DeepSeek may charge for API calls.
DEEPSEEK_API_KEY=
# Set true and start with: docker compose --profile cache up -d --build
REDIS_CACHE_ENABLED=false
# Compose Redis has no password by default; set only if configuring Redis auth separately.
REDIS_PASSWORD=
WEB_PORT=8080
